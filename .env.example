# Placeholders only. Copy to .env (git-ignored) or export in your shell; never commit real values.
# Passwords must be at least 12 characters. `trishul demo reset` and `trishul start` create the
# `approver` and `operator` accounts from these; an unset variable means that account is not created.
TRISHUL_APPROVER_PASSWORD=change-me-approver-pw
TRISHUL_OPERATOR_PASSWORD=change-me-operator-pw
# Optional: choose the operator bearer token (otherwise a random one is written to operator.token).
# TRISHUL_OPERATOR_TOKEN=
# Set to 1 when the API is served over HTTPS (adds Secure to the session cookie).
# TRISHUL_COOKIE_SECURE=1
# Audience red-team app: public submissions and tunnel rate-limit keying.
# TRISHUL_REDTEAM_PUBLIC=1
# TRISHUL_TRUSTED_PROXY=1
